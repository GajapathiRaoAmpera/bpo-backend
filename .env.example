# Copy to .env and fill in. Never commit .env.
# sandbox (default) or production. Production refuses to start with a short JWT_SECRET, COOKIE_SECURE=false or SQLite.
APP_ENV=sandbox
# Base URL for payment links (payments are still a pilot integration: links are not payable)
PAYMENT_LINK_BASE=https://pay.sandbox.assurevoice.in/r
GOOGLE_API_KEY=
JWT_SECRET=change-me-to-a-long-random-string
SEED_PASSWORD=change-me
DATABASE_URL=sqlite:///./assurevoice.db
# Supabase (Session pooler): postgresql+psycopg://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
FRONTEND_ORIGIN=http://localhost:3000
# Set true behind HTTPS
COOKIE_SECURE=false
# Voice agent models (defaults shown)
GEMINI_LIVE_MODEL=models/gemini-3.8-live
GEMINI_LIVE_VOICE=Kore
GEMINI_FLASH_MODEL=gemini-3.8-flash
GEMINI_FLASH_FALLBACK_MODELS=gemini-3.5-flash,gemini-flash-latest
